# Runner image for the Windows container E2E suite: stock servercore plus the
# pinned Go toolchain, so no host Go is needed on any arch. (There is no
# stock golang Windows image for arm64, hence this file instead of pinning
# one.) Built via compose --build (see compose.amd64.yaml / compose.arm64.yaml).
# Its Go also builds vfox from main for the suite's main combos.
ARG BASE_IMAGE=mcr.microsoft.com/windows/servercore:ltsc2025-KB5122871-amd64
FROM ${BASE_IMAGE}

SHELL ["powershell", "-NoProfile", "-Command"]

ARG GO_VERSION=1.27.1
# NB: no double quotes or backticks below. The classic builder wraps the
# joined lines in powershell -Command "..." through cmd.exe, where both
# break parsing. Single quotes, ${var} braces and array arguments only.
# A zip, not the MSI, which took over five minutes to install on arm64; the
# zip only extracts, and leaves the machine PATH to us.
RUN $goArch = if ($env:PROCESSOR_ARCHITECTURE -eq 'ARM64') { 'arm64' } else { 'amd64' }; `
    $goZip = $env:TEMP + '\go.zip'; `
    curl.exe -fsSL --retry 3 --retry-delay 5 --retry-all-errors -o $goZip https://go.dev/dl/go${env:GO_VERSION}.windows-${goArch}.zip; `
    tar.exe -xf $goZip -C 'C:\Program Files'; `
    if ($LASTEXITCODE -ne 0) { throw 'FAIL the Go zip extraction exited with code ' + $LASTEXITCODE }; `
    Remove-Item $goZip; `
    [Environment]::SetEnvironmentVariable('PATH', [Environment]::GetEnvironmentVariable('PATH', 'Machine') + ';C:\Program Files\Go\bin', 'Machine'); `
    New-Item -ItemType Directory -Force -Path 'C:\m', 'C:\b' | Out-Null; `
    & 'C:\Program Files\Go\bin\go.exe' version

# Short module/build caches: Windows long paths are off in this image.
ENV GOMODCACHE=C:\m
ENV GOCACHE=C:\b
